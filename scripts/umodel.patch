+/*-----------------------------------------------------------------------------
+	mcrl local patch: -mcrl-unpack
+-----------------------------------------------------------------------------*/
+
+// Copies bytes [0, End) of the package's uncompressed view to f, 1 MiB at a time.
+static void McrlCopyImage(UnPackage* Package, int End, FILE* f)
+{
+	guard(McrlCopyImage);
+
+	// Positions below the first compressed chunk come from the loader's header buffer: the plain summary, then the
+	// tables (decrypted for Rocket League). That buffer runs to the chunk's file offset, which can lie past the chunk's
+	// uncompressed offset, so the chunk is prepared explicitly when the copy reaches it.
+	FUE3ArchiveReader* UE3Loader = Package->Loader->CastTo<FUE3ArchiveReader>();
+	// An uncompressed package has no chunk: its whole view comes straight from the file.
+	int ChunkStart = UE3Loader && UE3Loader->CompressedChunks.Num() > 0
+		? min(UE3Loader->CompressedChunks[0].UncompressedOffset, End) : End;
+
+	static byte Buffer[1 << 20];
+	if (!Package->IsOpen()) Package->Open();	// closed once the tables were loaded
+	Package->SetStopper(0);
+	for (int Pos = 0; Pos < End; )
+	{
+		if (Pos == ChunkStart)
+			UE3Loader->PrepareBuffer(Pos);
+		int Size = min(End - Pos, (int)sizeof(Buffer));
+		if (Pos < ChunkStart)
+			Size = min(Size, ChunkStart - Pos);
+		Package->Seek(Pos);
+		Package->Serialize(Buffer, Size);
+		if (fwrite(Buffer, Size, 1, f) != 1)
+			appError("Write failed");
+		Pos += Size;
+	}
+	Package->CloseReader();
+
+	unguard;
+}
+
+// Writes <OutDir>/<Name>.bin: the package's uncompressed view up to the end of its headers and of every export.
+// Returns false when the package cannot be loaded.
+static bool McrlUnpackPackage(const char* PkgName, const char* OutDir)
+{
+	guard(McrlUnpackPackage);
+
+	UnPackage* Package = UnPackage::LoadPackage(PkgName);
+	if (!Package) return false;
+
+	int64 End = Package->Summary.HeadersSize;
+	for (int i = 0; i < Package->Summary.ExportCount; i++)
+	{
+		const FObjectExport& Exp = Package->ExportTable[i];
+		End = max(End, (int64)Exp.SerialOffset + Exp.SerialSize);
+	}
+	if (End > 0x7FFFFFFF) appError("Package image is larger than 2 GB");
+
+	char BinName[512], TmpName[512];
+	appSprintf(ARRAY_ARG(BinName), "%s/%s.bin", OutDir, Package->Name);
+	appSprintf(ARRAY_ARG(TmpName), "%s.tmp", BinName);
+	FILE* f = fopen(TmpName, "wb");
+	if (!f) appError("Unable to create %s", TmpName);
+	TRY {
+		McrlCopyImage(Package, (int)End, f);
+	} CATCH {
+		fclose(f);
+		remove(TmpName);
+		THROW_AGAIN;
+	}
+	if (fclose(f) != 0)
+	{
+		remove(TmpName);
+		appError("Write failed: %s", TmpName);
+	}
+#if _WIN32
+	remove(BinName);					// rename() does not replace an existing file on Windows
+#endif
+	if (rename(TmpName, BinName) != 0) appError("Unable to rename %s", TmpName);
+	appPrintf("mcrl-unpack: %s %d bytes\n", PkgName, (int)End);
+	return true;
+
+	unguardf("%s", PkgName);
+}
+
+// Writes every package's image; a package that fails is reported and the rest go on.
+// Returns the exit code: 0 when every package was written, else 1.
+static int McrlUnpack(const TArray<const char*>& Packages, const char* OutDir)
+{
+	appMakeDirectory(OutDir);
+	int NumFailed = 0;
+	for (int i = 0; i < Packages.Num(); i++)
+	{
+		bool Written = false;
+		TRY {
+			Written = McrlUnpackPackage(Packages[i], OutDir);
+		} CATCH {
+			GError.StandardHandler();			// prints the error and appends it to notify.log
+			GError.Reset();
+			GError.SetErrorHandler(ExceptionHandler);
+		}
+		if (!Written)
+		{
+			appPrintf("mcrl-unpack: FAILED %s\n", Packages[i]);
+			NumFailed++;
+		}
+	}
+	return NumFailed ? 1 : 0;
+}
